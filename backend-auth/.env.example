# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Llave para firmar los JWT. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Si se deja vacía, el servidor genera una temporal en cada arranque.
JWT_SECRET=cambia-esto

# Duraciones (segundos). Para la demo del silent refresh se puede bajar ACCESS_TOKEN_TTL a 20.
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=2592000
ELEVATED_TOKEN_TTL=600
STEP_UP_TOKEN_TTL=120

# Cliente público (la app móvil) y deep links permitidos, separados por coma.
CLIENT_ID=unisabana-mobile
REDIRECT_URIS=unisabana-auth://oauth/callback

# Usuario de demostración
DEMO_USERNAME=estudiante@unisabana.edu.co
DEMO_PASSWORD=Sabana2026!
# Semilla TOTP del usuario. Para crear una nueva: cd mobile-app && npm run qr -- --random
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
